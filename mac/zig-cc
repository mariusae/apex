#!/bin/sh
# C compiler and linker for cross-compiling to x86_64-linux-musl, via Zig.
# cc-rs passes Rust's target triple, which Zig does not know; drop it.
args=""
skip=0
for a in "$@"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$a" in
    --target=*) continue ;;
    -target) skip=1; continue ;;
  esac
  args="$args \"$a\""
done
eval set -- "$args"
# the Zig as crates/ghostty-vt-sys finds it: $ZIG, else zig on PATH, else
# the newest ~/.local/zig-*-0.16*/zig
zig=${ZIG:-}
if [ -z "$zig" ]; then zig=$(command -v zig || true); fi
if [ -z "$zig" ]; then zig=$(ls -d "$HOME"/.local/zig-*-0.16*/zig 2>/dev/null | sort | tail -1); fi
if [ -z "$zig" ]; then echo "zig-cc: no zig 0.16: put it on PATH or set ZIG" >&2; exit 1; fi
exec "$zig" cc -target x86_64-linux-musl "$@"
